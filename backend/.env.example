# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required for login to work securely — use a long random string in production
# (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-long-random-string

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
PORT=5000

# --- Optional: SMTP config for auto follow-up reminders + weekly digest emails ---
# If left blank, emails are just logged to the console instead of sent (no crash).
# Example values for Gmail: use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
